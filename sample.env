# Get from https://my.telegram.org/apps
APP_ID=123456
APP_HASH=your_app_hash_here

# MongoDB (optional — leave empty for in-memory)
MONGO_URL=mongodb://localhost:27017

# Choose ONE of the two below:
# Option 1 — Run as a Telegram Bot (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Option 2 — Run as a Userbot (string session)
STRING_SESSION=
