# ── Required ──────────────────────────────────────
API_ID=your_api_id
API_HASH=your_api_hash
BOT_TOKEN=your_bot_token        # from @BotFather
DATABASE_URL=mongodb://...      # MongoDB URL
OWNER_ID=your_personal_user_id  # from @userinfobot

# ── Optional ──────────────────────────────────────
LOGGER_ID=0                     # group/channel ID for logs
SUDO_USERS=123456 789012        # space-separated IDs
HANDLERS=. ! ?                  # userbot command prefixes
