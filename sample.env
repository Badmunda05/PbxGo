# ── Telegram API ─────────────────────────────────────────────
# Get these from https://my.telegram.org/apps
APP_ID=123456
APP_HASH=your_app_hash_here

# ── Owner ─────────────────────────────────────────────────────
# ⚠️  IMPORTANT: This must be YOUR personal Telegram user ID.
#     It is NOT the bot's ID. It is NOT your phone number.
#     How to get it: open Telegram, message @userinfobot, it replies with your ID.
#     Example: if @userinfobot says "Id: 987654321", set OWNER_ID=987654321
OWNER_ID=YOUR_PERSONAL_USER_ID_HERE

# ── MongoDB (optional) ────────────────────────────────────────
# Leave blank to store sudo users in memory only (lost on restart)
MONGO_URL=mongodb://localhost:27017

# ── Login Mode — choose ONE, leave the other blank ────────────

# Option 1: Bot Token (from @BotFather — for bot mode)
# ⚠️  When using BOT_TOKEN, OWNER_ID must still be your personal user ID,
#     NOT the bot's ID. The bot's ID and your personal ID are different numbers.
BOT_TOKEN=

# Option 2: String Session (for userbot mode)
# Run once without STRING_SESSION to generate one, then paste it here.
STRING_SESSION=
