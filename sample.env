# ── Telegram API ─────────────────────────────
# Get from https://my.telegram.org/apps
APP_ID=123456
APP_HASH=your_app_hash_here

# ── Owner ────────────────────────────────────
# Your Telegram User ID (get from @userinfobot)
OWNER_ID=123456789

# ── MongoDB (optional) ───────────────────────
# Leave empty to use in-memory storage
MONGO_URL=mongodb://localhost:27017

# ── Login Mode (choose ONE) ──────────────────
# Option 1: Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Option 2: Userbot String Session
STRING_SESSION=
